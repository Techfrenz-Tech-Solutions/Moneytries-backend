NODE_ENV=production
HOST=127.0.0.1
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenvault
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Moneytries

# InstantAlerts SMS gateway. The message must exactly match the approved DLT
# template; {{OTP}} is replaced with the generated six-digit code.
SMS_API_URL=https://instantalerts.in/api/smsapi
SMS_API_KEY=
SMS_ROUTE=2
SMS_SENDER=
SMS_OTP_TEMPLATE_ID=
SMS_OTP_MESSAGE_TEMPLATE=Your OTP for Moneytries is {{OTP}}. Please do not share this OTP.
SMS_TIMEOUT_MS=10000

# Firebase Admin SDK (FCM push). Path to the service-account JSON from
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_PATH=
